{
	"schemaVersion": 1,
	"id": "quickrebind",
	"version": "${version}",
	"name": "QuickRebind",
	"description": "Save your keybinds as presets and swap between them in two clicks. Presets live outside the instance folder, so the same set follows you into every modpack, launcher, Minecraft account and version on the PC.",
	"authors": [
		"Bogdan"
	],
	"contact": {
		"homepage": "https://github.com/OppaiMaster7/QuickRebind",
		"sources": "https://github.com/OppaiMaster7/QuickRebind",
		"issues": "https://github.com/OppaiMaster7/QuickRebind/issues"
	},
	"license": "CC0-1.0",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.bogdan.quickrebind.QuickRebindClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "~1.21.8",
		"java": ">=21",
		"fabric-api": "*"
	}
}
